{
  "name": "dsh-bili",
  "version": "0.1.0",
  "description": "Bilibili for DeepSeek Harness: resolve b23/BV links, read subtitles, hand the content to the model (roadmap: browse, share cards, live danmaku)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bilibili",
    "bili",
    "subtitle",
    "summary",
    "danmaku"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzwei1990/dsh-bili.git"
  },
  "homepage": "https://github.com/wzwei1990/dsh-bili#readme",
  "bugs": {
    "url": "https://github.com/wzwei1990/dsh-bili/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  }
}
